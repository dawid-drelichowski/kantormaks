{
  "name": "kantormaks-website",
  "version": "1.1.0",
  "description": "Kantormaks website based on Fastify",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js & npm run assets:dev",
    "assets:build": "glob-exec --foreach --parallel \"assets/css/{home,error,admin}.css\" -- \"lightningcss --bundle --minify --sourcemap {{file}} -o public/css/{{file.base}}\" && swc assets/js -d public --strip-leading-paths",
    "assets:dev": "chokidar 'assets/css/*.css' --initial -c 'lightningcss {path} --output-dir public/css' & swc assets/js -d public --strip-leading-paths --no-swcrc --watch",
    "lint": "eslint .",
    "test": "playwright install chromium && playwright test"
  },
  "author": "Dawid Drelichowski",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@fastify/basic-auth": "^6.3.0",
    "@fastify/formbody": "^9.0.0",
    "@fastify/static": "^10.1.3",
    "@fastify/view": "^12.0.0",
    "fastify": "^5.12.0",
    "handlebars": "^4.7.8",
    "qs": "^6.15.3"
  },
  "imports": {
    "#config": "./config.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@swc/cli": "^0.8.1",
    "@types/node": "^26.2.0",
    "glob-exec": "^0.1.1",
    "lightningcss-cli": "^1.33.0"
  }
}
